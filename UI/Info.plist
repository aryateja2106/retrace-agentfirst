<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>arya-retrace</string>
    <key>CFBundleDisplayName</key>
    <string>arya-retrace</string>
    <key>CFBundleIdentifier</key>
    <string>dev.arya.arya-retrace</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>Retrace</string>

    <!-- App Icon -->
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>

    <!-- URL schemes: legacy `retrace` + fork canonical `arya-retrace` -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>arya-retrace Deeplink</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>retrace</string>
                <string>arya-retrace</string>
            </array>
        </dict>
    </array>

    <!-- Minimum macOS version -->
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>

    <!-- Application Category -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>

    <!-- High Resolution Support -->
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- Privacy - Screen Recording Usage Description -->
    <key>NSScreenCaptureUsageDescription</key>
    <string>arya-retrace needs screen recording permission to capture your screen history. All data stays local and encrypted on your Mac.</string>

    <!-- Privacy - Accessibility Usage Description -->
    <key>NSAppleEventsUsageDescription</key>
    <string>arya-retrace needs Automation permission to extract the browser url. If you are seeing this notice, you are likely using an application that does not support url extraction via accessibility APIs, so URL extraction needs to be done via Apple Script. All data stays local and encrypted on your Mac.</string>

    <!-- Required Entitlements -->
    <key>com.apple.security.device.screen-recording</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <key>LSUIElement</key>
    <false/>

    <key>NSRequiresAquaSystemAppearance</key>
    <false/>

    <key>LSMultipleInstancesProhibited</key>
    <true/>

    <!-- Private fork: do not contact upstream Retrace appcast. Sparkle init is skipped when true. -->
    <key>AryaRetraceDisableSparkleUpdates</key>
    <true/>

    <!-- Sparkle keys kept for future public releases; feed unused while AryaRetraceDisableSparkleUpdates is YES -->
    <key>SUFeedURL</key>
    <string></string>
    <key>SUEnableAutomaticChecks</key>
    <false/>
    <key>SUScheduledCheckInterval</key>
    <integer>86400</integer>
    <key>SUAllowsAutomaticUpdates</key>
    <false/>
    <key>SUAutomaticallyUpdate</key>
    <false/>
    <key>SUShowReleaseNotes</key>
    <true/>
    <key>SUPublicEDKey</key>
    <string>pM8r2LSHH+MAg7cpZDAle5ZjRB4Kfd4aOaUnud2ePA8=</string>
</dict>
</plist>
